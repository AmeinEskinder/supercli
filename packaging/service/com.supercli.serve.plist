<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  SuperCLI Host service — macOS per-user LaunchAgent.

  Usable verbatim when `supercli` is installed at /usr/local/bin/supercli
  (the install.sh default):

    cp com.supercli.serve.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.supercli.serve.plist

  `supercli serve install` writes this same file with the resolved binary
  path (it rewrites the /usr/local/bin/supercli line, and for a scoped
  workspace unit the label plus the ProgramArguments serve line).

  This must stay a per-user LaunchAgent, never a root LaunchDaemon: the
  service owns ~/.supercli state, the user Keychain, and the per-user machine
  lease. A headless Mac therefore needs automatic login for the hosting
  user so the gui/<uid> domain exists at boot.

  Stdout/stderr are intentionally not captured: durable diagnostics go to
  ~/.supercli/hooks/trace.log.
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.supercli.serve</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/local/bin/supercli</string>
		<string>serve</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>ThrottleInterval</key>
	<integer>10</integer>
	<key>ProcessType</key>
	<string>Interactive</string>
</dict>
</plist>
